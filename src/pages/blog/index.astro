---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import NewsletterBox from '../../components/NewsletterBox.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../data/content';
const posts = (await getCollection('posts', ({ data }) => data.status === 'publicado')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const countByCategory = (slug: string) => posts.filter((post) => post.data.category === slug).length;
---
<Base title='Artigos — Ensinamentos da Vida' description='Artigos práticos sobre hábitos, foco, disciplina, autenticidade e autorresponsabilidade.' path='/blog'>
<section class='border-b border-borda pb-16 pt-36 sm:pt-44'>
<div class='container-x grid gap-10 lg:grid-cols-12'>
<div class='lg:col-span-8'>
<p class='eyebrow reveal flex items-center gap-4'><span class='h-px w-14 bg-accent'></span>Biblioteca editorial</p>
<h1 class='title-display reveal mt-8'>Artigos</h1>
<p class='reveal mt-6 max-w-2xl text-lg leading-[1.8] text-texto/85'>Conteúdo direto para agir. Nada de texto para salvar e nunca mais abrir.</p>
</div>
<aside class='reveal lg:col-span-4 lg:border-l lg:border-borda lg:pl-10'>
<p class='meta-label'>Publicados</p>
<p class='mt-4 font-display text-5xl text-titulo'>{posts.length}</p>
<p class='mt-2 text-sm text-texto/75'>artigos disponíveis para leitura.</p>
</aside>
</div>
</section>
<section class='section'>
<div class='container-x'>
<div class='section-header reveal'>
<h2 class='title-section'>Explorar por categoria</h2>
</div>
<div class='mt-8 flex flex-wrap gap-3'>
<a href='/blog' class='inline-flex min-h-11 items-center border border-accent bg-accent px-4 py-2 font-ui text-[11px] font-bold uppercase tracking-[0.16em] text-accent-ink'>Todos</a>
{categories.filter((category) => countByCategory(category.slug) > 0).map((category) => (
<a href={`/blog/${category.slug}`} class='inline-flex min-h-11 items-center border border-borda px-4 py-2 font-ui text-[11px] font-bold uppercase tracking-[0.16em] text-texto/75 transition-colors duration-200 hover:border-accent hover:text-accent'>{category.name} · {countByCategory(category.slug)}</a>
))}
</div>
<div class='mt-12 grid gap-6 md:grid-cols-2'>
{posts.map((post, index) => (
<div class='reveal' style={`transition-delay:${index * 50}ms`}>
<PostCard post={post} />
</div>
))}
</div>
<div class='reveal mt-14'>
<NewsletterBox title='Não perca os próximos artigos' description='A gente publica conteúdo prático e envia uma ideia por semana no Telegram. É a nossa newsletter oficial.' />
</div>
</div>
</section>
</Base>