---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { categories, getCategory } from '../../data/content';
export async function getStaticPaths() {
  return categories.map((category) => ({ params: { categoria: category.slug }, props: { categorySlug: category.slug } }));
}
const { categorySlug } = Astro.props;
const category = getCategory(categorySlug);
const posts = (await getCollection('posts', ({ data }) => data.status === 'publicado' && data.category === categorySlug)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<Base title={`${category?.name ?? 'Categoria'} — Artigos — Ensinamentos da Vida`} description={category?.description ?? 'Artigos por categoria.'} path={`/blog/${categorySlug}`} noindex={posts.length === 0}>
<section class='mx-auto w-full max-w-5xl px-6 pb-24 pt-36 sm:px-8'>
<p class='font-ui text-xs font-semibold uppercase tracking-[0.25em] text-accent'>Categoria</p>
<h1 class='mt-3 font-display text-4xl text-titulo sm:text-5xl'>{category?.name ?? categorySlug}</h1>
<p class='mt-4 max-w-2xl text-base leading-relaxed text-texto/70'>{category?.description ?? ''}</p>
<div class='mt-8 flex flex-wrap gap-2 border-b border-white/5 pb-8'>
<a href='/blog' class='rounded-full bg-white/5 px-4 py-1.5 font-ui text-xs font-semibold text-texto/70 hover:bg-white/10 hover:text-titulo'>Todos</a>
{categories.map((item) => (
<a href={`/blog/${item.slug}`} class:list={['rounded-full px-4 py-1.5 font-ui text-xs font-semibold', item.slug === categorySlug ? 'bg-accent text-fundo' : 'bg-white/5 text-texto/70 hover:bg-white/10 hover:text-titulo']}>{item.name}</a>
))}
</div>
<div class='mt-10 grid gap-6'>
{posts.length > 0 ? posts.map((post) => (<PostCard post={post} />)) : <p class='text-texto/70'>Nenhum artigo publicado nesta categoria ainda.</p>}
</div>
</section>
</Base>