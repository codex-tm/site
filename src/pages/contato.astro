---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title='Contato — Ensinamentos da Vida' description='Fale com o Ensinamentos da Vida pelo Telegram.' path='/contato'>
<section class='mx-auto flex min-h-[70vh] w-full max-w-3xl flex-col justify-center px-6 py-36 sm:px-8'>
<p class='font-ui text-xs font-semibold uppercase tracking-[0.25em] text-accent'>Contato</p>
<h1 class='mt-3 font-display text-4xl leading-tight text-titulo sm:text-5xl'>Fale com a gente</h1>
<p class='mt-6 max-w-xl text-lg leading-[1.8] text-texto/80'>Para dúvidas, parcerias ou suporte, use o Telegram. É o canal mais rápido.</p>
<div class='mt-10 flex flex-wrap gap-4'>
<a href={site.telegram} target='_blank' rel='noopener noreferrer' class='rounded-full bg-accent px-7 py-3.5 font-ui text-sm font-semibold text-fundo'>Falar no Telegram</a>
<a href='/comece-aqui' class='rounded-full border border-white/10 px-7 py-3.5 font-ui text-sm font-semibold text-titulo hover:bg-white/5'>Começar por aqui</a>
</div>
<div class='mt-10 rounded-2xl border border-white/5 bg-white/[0.02] p-6 text-sm leading-relaxed text-texto/70'>Se o assunto for sobre o bot, entre primeiro no bot. Muitas dúvidas são respondidas por lá.</div>
</section>
</Base>