---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { categories } from '../data/content';
import NewsletterBox from '../components/NewsletterBox.astro';
const posts = (await getCollection('posts', ({ data }) => data.status === 'publicado')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const countByCategory = (slug: string) => posts.filter((post) => post.data.category === slug).length;
---
<Base title='Ensinamentos da Vida — Hábitos, foco e disciplina' path='/'>
<section class='border-b border-borda pb-20 pt-36 sm:pt-44 lg:pb-28'>
<div class='container-x grid gap-12 lg:grid-cols-12'>
<div class='lg:col-span-8'>
<p class='eyebrow reveal flex items-center gap-4'><span class='h-px w-14 bg-accent'></span>Blog editorial</p>
<h1 class='title-display reveal mt-8'>Você não precisa de motivação.<br /><span class='italic text-accent'>Precisa de sistema.</span></h1>
<p class='reveal mt-8 max-w-xl text-lg leading-[1.8] text-texto/85'>Artigos práticos sobre hábitos, foco, disciplina e autorresponsabilidade. Texto direto para ler, entender e aplicar.</p>
<div class='reveal mt-10 flex flex-wrap gap-4'>
<a href='/blog' class='btn-primary'>Ler artigos</a>
<a href='/sobre' class='btn-secondary'>Conhecer o projeto</a>
</div>
</div>
<aside class='reveal lg:col-span-4 lg:border-l lg:border-borda lg:pl-10'>
<p class='meta-label'>O que você encontra aqui</p>
<ul class='mt-5 space-y-4 text-sm leading-relaxed text-texto/75'>
<li class='border-l-2 border-accent/40 pl-4'>Conteúdo prático, sem promessa mágica.</li>
<li class='border-l-2 border-accent/40 pl-4'>Artigos organizados por categoria.</li>
<li class='border-l-2 border-accent/40 pl-4'>Leitura direta, sem enrolação.</li>
</ul>
</aside>
</div>
</section>
<section class='section'>
<div class='container-x'>
<div class='section-header reveal'>
<h2 class='title-section'>Últimos artigos</h2>
<a href='/blog' class='link-arrow'>Ver todos</a>
</div>
<div class='mt-10 grid gap-6 md:grid-cols-2'>
{posts.map((post) => (<PostCard post={post} />))}
</div>
</div>
</section>
<section class='section bg-painel'>
<div class='container-x'>
<div class='section-header reveal'>
<h2 class='title-section'>Categorias</h2>
<a href='/blog' class='link-arrow'>Ver blog</a>
</div>
<div class='mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4'>
{categories.filter((category) => countByCategory(category.slug) > 0).map((category, index) => (
<a href={`/blog/${category.slug}`} class='card card-hover reveal flex h-full flex-col p-7' style={`transition-delay:${index * 50}ms`}>
<p class='meta-label'>{countByCategory(category.slug)} artigos</p>
<h3 class='mt-4 font-display text-2xl text-titulo'>{category.name}</h3>
<p class='mt-3 flex-1 text-sm leading-relaxed text-texto/75'>{category.description}</p>
<span class='link-arrow mt-6'>Explorar</span>
</a>
))}
</div>
</div>
</section>
<section class='section'>
<div class='container-x reveal'>
<NewsletterBox />
</div>
</section>
<section class='section'>
<div class='container-x max-w-4xl text-center'>
<span class='reveal mx-auto block h-px w-24 bg-accent'></span>
<blockquote class='reveal mt-10 font-display text-4xl italic leading-tight text-titulo sm:text-5xl'>O caminho da verdade é solitário. Mas é o único que te leva ao topo.</blockquote>
<p class='reveal mt-8 meta-label'>Ensinamentos da Vida</p>
</div>
</section>
<section class='section'>
<div class='container-x grid gap-10 lg:grid-cols-12'>
<div class='lg:col-span-7'>
<div class='section-header reveal'>
<h2 class='title-section'>Sobre o projeto</h2>
</div>
<p class='reveal mt-8 max-w-2xl text-base leading-[1.85] text-texto/85'>O Ensinamentos da Vida é um projeto editorial focado em comportamento. A proposta é simples: transformar reflexão em ação, sem coach, sem atalho e sem motivação barata.</p>
<p class='reveal mt-4 max-w-2xl text-base leading-[1.85] text-texto/85'>Cada artigo existe para gerar uma mudança prática. Se não dá para aplicar, não interessa.</p>
<a href='/sobre' class='link-arrow reveal mt-8'>Ler mais sobre</a>
</div>
<aside class='reveal lg:col-span-5 lg:border-l lg:border-borda lg:pl-10'>
<p class='meta-label'>Linha editorial</p>
<ul class='mt-5 space-y-4 text-sm leading-relaxed text-texto/75'>
<li class='border-l-2 border-accent/40 pl-4'>Segunda pessoa, sempre.</li>
<li class='border-l-2 border-accent/40 pl-4'>Frases curtas e diretas.</li>
<li class='border-l-2 border-accent/40 pl-4'>Responsabilidade acima de desculpa.</li>
<li class='border-l-2 border-accent/40 pl-4'>Ação acima de discurso.</li>
</ul>
</aside>
</div>
</section>
<section class='section'>
<div class='container-x max-w-3xl text-center'>
<span class='reveal mx-auto block h-px w-24 bg-accent'></span>
<h2 class='title-section reveal mt-10'>Continue lendo.</h2>
<p class='reveal mt-5 text-base leading-[1.75] text-texto/75'>Escolha um artigo e termine hoje. Nada de salvar para depois.</p>
<a href='/blog' class='btn-primary reveal mt-9'>Ver todos os artigos</a>
</div>
</section>
</Base>