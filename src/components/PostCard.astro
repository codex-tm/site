---
import type { CollectionEntry } from 'astro:content';
import { getCategory } from '../data/content';
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const category = getCategory(post.data.category);
const dateLabel = post.data.date.toLocaleDateString('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' });
---
<a href={`/blog/${post.data.slug}`} class='group card card-hover flex h-full flex-col p-7 sm:p-9'>
<div class='flex flex-wrap items-center gap-3 font-ui text-[11px] uppercase tracking-[0.18em] text-texto/50'>
<span class='border border-accent/40 px-2.5 py-1 text-accent'>{category?.name ?? post.data.category}</span>
<span>{post.data.readTime ?? '5 min'}</span>
<time datetime={post.data.date.toISOString()}>{dateLabel}</time>
</div>
<h3 class='mt-6 font-display text-3xl leading-tight text-titulo transition-colors group-hover:text-accent'>{post.data.title}</h3>
<p class='mt-4 flex-1 text-[15px] leading-[1.75] text-texto/70'>{post.data.excerpt}</p>
<span class='mt-7 inline-flex items-center gap-2 font-ui text-[11px] font-bold uppercase tracking-[0.18em] text-accent'>Ler artigo <span class='transition-transform duration-300 group-hover:translate-x-1'>→</span></span>
</a>