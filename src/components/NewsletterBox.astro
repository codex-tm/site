---
import { site } from '../data/site';
interface Props { title?: string; description?: string; }
const { title = 'Receba 1 ideia por semana', description = 'O bot é a nossa newsletter. Uma leitura curta por semana, direto no Telegram. Sem spam, sem promessa, sem flood.' } = Astro.props;
---
<div class='card border-accent/25 bg-painel p-8 sm:p-10'>
<div class='flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between'>
<div class='max-w-2xl'>
<p class='eyebrow'>Newsletter</p>
<h2 class='mt-4 font-display text-3xl text-titulo sm:text-4xl'>{title}</h2>
<p class='mt-3 text-sm leading-relaxed text-texto/75'>{description}</p>
</div>
<div class='flex flex-col gap-3 sm:flex-row sm:items-center lg:flex-col xl:flex-row'>
<a href={site.telegram} target='_blank' rel='noopener noreferrer' class='btn-primary'>Receber no Telegram</a>
<span class='meta-label'>Grátis · sai quando quiser</span>
</div>
</div>
</div>