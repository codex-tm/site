---
import { site } from '../data/site';
const { pathname } = Astro.url;
const isActive = (href: string) => (href === '/' ? pathname === '/' : pathname.startsWith(href));
---
<header class='fixed inset-x-0 top-0 z-50 border-b border-borda bg-fundo/95'>
<nav class='container-x flex items-center justify-between py-4'>
<a href='/' class='group flex min-h-11 items-center gap-3'>
<span class='flex h-10 w-10 items-center justify-center border border-accent font-display text-sm text-accent'>{site.logo}</span>
<span class='font-ui text-xs font-bold uppercase tracking-[0.22em] text-titulo transition-colors duration-200 group-hover:text-accent'>{site.name}</span>
</a>
<div class='hidden items-center gap-7 md:flex'>
{site.nav.map((item) => (
<a href={item.href} class:list={['min-h-11 inline-flex items-center font-ui text-[11px] font-bold uppercase tracking-[0.18em] transition-colors duration-200', isActive(item.href) ? 'text-accent' : 'text-texto/75 hover:text-titulo']}>{item.label}</a>
))}
</div>
<a href={site.telegram} target='_blank' rel='noopener noreferrer' class='btn-primary hidden !px-5 md:inline-flex'>Receber ideias</a>
<button id='menu-button' type='button' aria-label='Alternar menu' aria-expanded='false' class='flex h-11 w-11 cursor-pointer items-center justify-center border border-borda text-titulo transition-colors duration-200 hover:border-accent hover:text-accent md:hidden'>
<svg class='h-5 w-5' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M4 6h16M4 12h16M4 18h16' /></svg>
</button>
</nav>
<div id='mobile-menu' class='hidden border-t border-borda bg-fundo md:hidden'>
<div class='container-x flex flex-col gap-2 py-6'>
{site.nav.map((item) => (
<a href={item.href} class:list={['flex min-h-11 items-center border-b border-borda font-ui text-xs font-bold uppercase tracking-[0.18em]', isActive(item.href) ? 'text-accent' : 'text-titulo hover:text-accent']}>{item.label}</a>
))}
<a href={site.telegram} target='_blank' rel='noopener noreferrer' class='btn-primary mt-4'>Receber ideias</a>
</div>
</div>
</header>
<script>
const button = document.getElementById('menu-button');
const menu = document.getElementById('mobile-menu');
button?.addEventListener('click', () => {
  const open = menu?.classList.toggle('hidden') === false;
  button?.setAttribute('aria-expanded', String(open));
});
</script>