---
import { site } from '../data/site';
import { categories } from '../data/content';
import { getCollection } from 'astro:content';
const year = new Date().getFullYear();
const posts = await getCollection('posts', ({ data }) => data.status === 'publicado');
const usedCategories = categories.filter((category) => posts.some((post) => post.data.category === category.slug));
const navigationLinks = [{ label: 'Home', href: '/' }, { label: 'Artigos', href: '/blog' }, { label: 'Sobre', href: '/sobre' }, { label: 'Contato', href: '/contato' }];
---
<footer class='border-t border-borda bg-painel'>
<div class='container-x grid gap-12 py-16 md:grid-cols-4'>
<div>
<a href='/' class='flex min-h-11 items-center gap-3'>
<span class='flex h-10 w-10 items-center justify-center border border-accent font-display text-sm text-accent'>{site.logo}</span>
<span class='font-ui text-xs font-bold uppercase tracking-[0.22em] text-titulo'>{site.name}</span>
</a>
<p class='mt-5 max-w-xs text-sm leading-relaxed text-texto/75'>{site.tagline}</p>
</div>
<div>
<h2 class='meta-label text-accent'>Navegação</h2>
<ul class='mt-5 space-y-1'>
{navigationLinks.map((link) => (
<li><a href={link.href} class='inline-flex min-h-9 items-center text-sm text-texto/75 transition-colors duration-200 hover:text-titulo'>{link.label}</a></li>
))}
</ul>
</div>
<div>
<h2 class='meta-label text-accent'>Categorias</h2>
<ul class='mt-5 space-y-1'>
{usedCategories.map((category) => (
<li><a href={`/blog/${category.slug}`} class='inline-flex min-h-9 items-center text-sm text-texto/75 transition-colors duration-200 hover:text-titulo'>{category.name}</a></li>
))}
</ul>
</div>
<div>
<h2 class='meta-label text-accent'>Newsletter</h2>
<p class='mt-5 text-sm leading-relaxed text-texto/75'>Receba 1 ideia prática por semana no Telegram. Sem spam. Sai quando quiser.</p>
<a href={site.telegram} target='_blank' rel='noopener noreferrer' class='btn-primary mt-6'>Receber ideias</a>
</div>
</div>
<div class='border-t border-borda py-6 text-center font-ui text-[11px] uppercase tracking-[0.2em] text-texto/45'>
<p>© {year} {site.name}. Todos os direitos reservados.</p>
<p class='mt-2'>{site.signature}</p>
</div>
</footer>