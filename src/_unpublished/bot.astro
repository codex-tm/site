---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const benefits = [{ title: '1 ideia por semana', description: 'Conteúdo curto, prático e aplicável no mesmo dia.' }, { title: 'Sem spam', description: 'Nada de corrente, promessa mágica ou flood.' }, { title: 'Leitura de 3 minutos', description: 'Direto ao ponto. Para ler no café, no trânsito ou antes de dormir.' }];
const steps = [{ number: '1', title: 'Clique em iniciar', description: 'Você será direcionado para o bot no Telegram.' }, { number: '2', title: 'Receba a primeira ideia', description: 'O conteúdo chega direto no seu Telegram.' }, { number: '3', title: 'Aplique e ajuste', description: 'Use o que funciona. Descarte o que não serve.' }];
---
<Base title='Bot Telegram — Ensinamentos da Vida' description='Receba 1 ideia prática por semana direto no Telegram. Sem spam, sem enrolação.' path='/bot'>
<section class='relative overflow-hidden pb-20 pt-36 sm:pt-44'>
<div class='pointer-events-none absolute inset-0'><div class='absolute left-1/2 top-0 h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-accent/5 blur-[120px]'></div></div>
<div class='relative mx-auto w-full max-w-4xl px-6 sm:px-8'>
<p class='inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/10 px-4 py-1.5 font-ui text-xs font-semibold text-accent'><span class='h-1.5 w-1.5 rounded-full bg-accent'></span>Telegram · 100% gratuito</p>
<h1 class='mt-7 max-w-3xl font-display text-4xl leading-tight text-titulo sm:text-6xl'>1 ideia prática por semana. Direto no seu Telegram.</h1>
<p class='mt-6 max-w-2xl text-lg leading-[1.8] text-texto/80'>Sem spam. Sem promessa mágica. Só uma leitura curta que pode mudar a forma como você age no mesmo dia.</p>
<div class='mt-10 flex flex-wrap gap-4'>
<a href={site.telegram} target='_blank' rel='noopener noreferrer' class='rounded-full bg-accent px-7 py-3.5 font-ui text-sm font-semibold text-fundo'>Iniciar o bot</a>
<a href='/blog' class='rounded-full border border-white/10 px-7 py-3.5 font-ui text-sm font-semibold text-titulo hover:bg-white/5'>Ler artigos</a>
</div>
</div>
</section>
<section class='border-t border-white/5 py-20'>
<div class='mx-auto w-full max-w-5xl px-6 sm:px-8'>
<h2 class='font-display text-3xl text-titulo sm:text-4xl'>O que você recebe</h2>
<div class='mt-10 grid gap-5 md:grid-cols-3'>
{benefits.map((benefit) => (
<div class='rounded-2xl border border-white/5 bg-white/[0.02] p-7'>
<h3 class='font-display text-xl text-titulo'>{benefit.title}</h3>
<p class='mt-3 text-sm leading-relaxed text-texto/70'>{benefit.description}</p>
</div>
))}
</div>
</div>
</section>
<section class='border-t border-white/5 bg-superficie/30 py-20'>
<div class='mx-auto w-full max-w-4xl px-6 sm:px-8'>
<h2 class='font-display text-3xl text-titulo sm:text-4xl'>Como funciona</h2>
<div class='mt-10 space-y-4'>
{steps.map((step) => (
<div class='flex items-start gap-5 rounded-2xl border border-white/5 bg-white/[0.02] p-6'>
<span class='flex h-10 w-10 flex-none items-center justify-center rounded-full border border-accent/20 font-display text-accent'>{step.number}</span>
<div>
<h3 class='font-display text-xl text-titulo'>{step.title}</h3>
<p class='mt-2 text-sm leading-relaxed text-texto/70'>{step.description}</p>
</div>
</div>
))}
</div>
</div>
</section>
<section class='border-t border-white/5 py-24'>
<div class='mx-auto w-full max-w-2xl px-6 text-center sm:px-8'>
<h2 class='font-display text-4xl text-titulo sm:text-5xl'>Começa hoje.</h2>
<p class='mt-5 text-base leading-[1.75] text-texto/70'>Se não agregar valor, você sai quando quiser.</p>
<a href={site.telegram} target='_blank' rel='noopener noreferrer' class='mt-8 inline-block rounded-full bg-accent px-8 py-4 font-ui text-sm font-semibold text-fundo'>Iniciar o bot</a>
</div>
</section>
</Base>