---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
const steps = [{ number: '01', title: 'Leia um artigo', description: 'Escolha um artigo e termine a leitura hoje. Nada de salvar para depois.', href: '/blog', cta: 'Ver artigos', external: false }, { number: '02', title: 'Receba 1 ideia por semana', description: 'Assine o bot Telegram e receba conteúdo prático sem spam.', href: site.telegram, cta: 'Iniciar bot', external: true }, { number: '03', title: 'Entenda o método', description: 'Veja os pilares que sustentam o sistema: sistema, consistência e responsabilidade.', href: '/metodo', cta: 'Ver método', external: false }, { number: '04', title: 'Prepare-se para o curso', description: 'Conheça a jornada completa em áudio com 5 módulos e 27 aulas.', href: '/curso', cta: 'Ver curso', external: false }];
---
<Base title='Comece aqui — Ensinamentos da Vida' description='O caminho mais rápido para entrar no Ensinamentos da Vida: artigos, bot Telegram, método e curso.' path='/comece-aqui'>
<section class='mx-auto w-full max-w-5xl px-6 pb-20 pt-36 sm:px-8'>
<p class='font-ui text-xs font-semibold uppercase tracking-[0.25em] text-accent'>Comece aqui</p>
<h1 class='mt-3 max-w-3xl font-display text-4xl leading-tight text-titulo sm:text-6xl'>Um caminho simples. Quatro passos.</h1>
<p class='mt-6 max-w-2xl text-lg leading-[1.8] text-texto/80'>Se você não sabe por onde começar, siga esta ordem. Ela foi feita para tirar você da inércia sem enrolação.</p>
</section>
<section class='border-t border-white/5 py-20'>
<div class='mx-auto grid w-full max-w-5xl gap-5 px-6 sm:px-8 md:grid-cols-2'>
{steps.map((step) => (
<div class='flex h-full flex-col rounded-2xl border border-white/5 bg-white/[0.02] p-8'>
<span class='font-display text-4xl text-accent/20'>{step.number}</span>
<h2 class='mt-4 font-display text-2xl text-titulo'>{step.title}</h2>
<p class='mt-3 flex-1 text-sm leading-relaxed text-texto/70'>{step.description}</p>
{step.external ? (
<a href={step.href} target='_blank' rel='noopener noreferrer' class='mt-6 inline-flex w-fit rounded-full bg-accent px-5 py-2.5 font-ui text-xs font-semibold text-fundo'>{step.cta}</a>
) : (
<a href={step.href} class='mt-6 inline-flex w-fit rounded-full border border-accent/30 px-5 py-2.5 font-ui text-xs font-semibold text-accent hover:bg-accent hover:text-fundo'>{step.cta}</a>
)}
</div>
))}
</div>
</section>
<section class='border-t border-white/5 py-24'>
<div class='mx-auto w-full max-w-2xl px-6 text-center sm:px-8'>
<h2 class='font-display text-4xl text-titulo sm:text-5xl'>Ação pequena hoje vale mais que plano perfeito amanhã.</h2>
<a href={site.telegram} target='_blank' rel='noopener noreferrer' class='mt-8 inline-block rounded-full bg-accent px-8 py-4 font-ui text-sm font-semibold text-fundo'>Iniciar o bot</a>
</div>
</section>
</Base>