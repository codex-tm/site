---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { course } from '../data/content';
---
<Base title={`${course.name} — Ensinamentos da Vida`} description='Curso 100% em áudio com 5 módulos e 27 aulas para construir disciplina, identidade e liberdade.' path='/curso'>
<section class='relative overflow-hidden pb-20 pt-36 sm:pt-44'>
<div class='pointer-events-none absolute inset-0'><div class='absolute left-1/2 top-0 h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-accent/5 blur-[120px]'></div></div>
<div class='relative mx-auto w-full max-w-5xl px-6 sm:px-8'>
<p class='inline-flex items-center gap-2 rounded-full border border-accent/20 bg-accent/10 px-4 py-1.5 font-ui text-xs font-semibold text-accent'>Curso em áudio · Em breve</p>
<h1 class='mt-7 max-w-4xl font-display text-4xl leading-tight text-titulo sm:text-6xl'>{course.name}</h1>
<p class='mt-6 max-w-2xl text-lg leading-[1.8] text-texto/80'>{course.headline}</p>
<p class='mt-4 max-w-2xl text-base leading-relaxed text-texto/70'>{course.sub}</p>
<div class='mt-10 flex flex-wrap gap-4'>
<a href={site.telegram} target='_blank' rel='noopener noreferrer' class='rounded-full bg-accent px-7 py-3.5 font-ui text-sm font-semibold text-fundo'>Entrar na lista de espera</a>
<a href='/metodo' class='rounded-full border border-white/10 px-7 py-3.5 font-ui text-sm font-semibold text-titulo hover:bg-white/5'>Conhecer o método</a>
</div>
<div class='mt-14 grid max-w-xl grid-cols-3 gap-6 border-t border-white/5 pt-8'>
<div><p class='font-display text-3xl text-titulo'>{course.modules}</p><p class='mt-1 font-ui text-xs uppercase tracking-[0.15em] text-texto/40'>módulos</p></div>
<div><p class='font-display text-3xl text-titulo'>{course.lessons}</p><p class='mt-1 font-ui text-xs uppercase tracking-[0.15em] text-texto/40'>aulas</p></div>
<div><p class='font-display text-3xl text-titulo'>100%</p><p class='mt-1 font-ui text-xs uppercase tracking-[0.15em] text-texto/40'>áudio</p></div>
</div>
</div>
</section>
<section class='border-t border-white/5 py-20'>
<div class='mx-auto grid w-full max-w-5xl gap-6 px-6 sm:px-8 md:grid-cols-2'>
<div class='rounded-2xl border border-white/5 bg-white/[0.02] p-8'>
<h2 class='font-display text-2xl text-titulo'>Para quem é</h2>
<ul class='mt-5 space-y-3'>
{course.for.map((item) => (
<li class='flex items-start gap-3 text-sm leading-relaxed text-texto/70'><span class='mt-1 text-accent'>→</span>{item}</li>
))}
</ul>
</div>
<div class='rounded-2xl border border-white/5 bg-white/[0.02] p-8'>
<h2 class='font-display text-2xl text-titulo'>Para quem não é</h2>
<ul class='mt-5 space-y-3'>
{course.notFor.map((item) => (
<li class='flex items-start gap-3 text-sm leading-relaxed text-texto/70'><span class='mt-1 text-texto/40'>✕</span>{item}</li>
))}
</ul>
</div>
</div>
</section>
<section class='border-t border-white/5 bg-superficie/30 py-20'>
<div class='mx-auto w-full max-w-4xl px-6 sm:px-8'>
<p class='font-ui text-xs font-semibold uppercase tracking-[0.25em] text-accent'>Conteúdo</p>
<h2 class='mt-3 font-display text-3xl text-titulo sm:text-4xl'>5 módulos para atravessar a transformação</h2>
<div class='mt-10 space-y-4'>
{course.modulesList.map((module) => (
<details class='group rounded-2xl border border-white/5 bg-white/[0.02] p-6'>
<summary class='flex cursor-pointer list-none items-start justify-between gap-4'>
<div class='flex items-start gap-4'>
<span class='font-display text-2xl text-accent/30'>0{module.number}</span>
<div>
<h3 class='font-display text-xl text-titulo'>{module.title}</h3>
<p class='mt-1 text-sm text-texto/70'>{module.description}</p>
</div>
</div>
<span class='text-accent transition-transform duration-300 group-open:rotate-45'>+</span>
</summary>
<ul class='mt-5 space-y-2 border-t border-white/5 pt-5'>
{module.lessons.map((lesson) => (
<li class='text-sm text-texto/70'>• {lesson}</li>
))}
</ul>
</details>
))}
</div>
</div>
</section>
<section class='border-t border-white/5 py-24'>
<div class='mx-auto w-full max-w-2xl px-6 text-center sm:px-8'>
<h2 class='font-display text-4xl text-titulo sm:text-5xl'>Quando abrir, você fica sabendo primeiro.</h2>
<p class='mt-5 text-base leading-[1.75] text-texto/70'>Entre no Telegram e acompanhe a abertura da turma.</p>
<a href={site.telegram} target='_blank' rel='noopener noreferrer' class='mt-8 inline-block rounded-full bg-accent px-8 py-4 font-ui text-sm font-semibold text-fundo'>Entrar na lista</a>
</div>
</section>
</Base>